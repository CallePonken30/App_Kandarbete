{
  "name": "mcode",
  "version": "1.0.0",
  "description": "mcode app",
  "main": "main.js",
  "scripts": {
    "start-backend": "backend/venv/bin/gunicorn --chdir backend -w 4 -b 127.0.0.1:5050 run:app",
    "start-backend-prod": "backend/venv/bin/gunicorn -w 4 -b 127.0.0.1:5050 run:app",
    "start": "concurrently \"npm run start-backend\" \"npm run start-react\" \"npm run start-electron\"",
    "start-react": "cd frontend && npm start",
    "start-electron": "wait-on http://localhost:3000 && electron .",
    "dist": "electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "io.github.carlhumborg.mcode",
    "files": [
      "main.js",
      "package.json",
      "frontend/build/**/*",
      "node_modules/**/*",
      "electron-backend/**/*"
    ],
    "extraResources": [
      {
        "from": "electron-backend",
        "to": "backend"
      }
    ],
    "asarUnpack": [],
    "mac": {
      "icon": "frontend/src/designs/logo.icns",
      "target": "dmg"
    },
    "win": {
      "icon": "frontend/src/designs/logo.ico"
    },
    "linux": {
      "icon": "frontend/src/designs/logo.png"
    }
  },
  "dependencies": {
    "axios": "^1.9.0"
  }
}
